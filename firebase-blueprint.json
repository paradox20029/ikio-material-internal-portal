{
  "entities": {
    "User": {
      "title": "User",
      "description": "Plant staff, operators, supervisors, store managers, and administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "employeeId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["Administrator", "Data Entry Staff", "Production Supervisor", "Store Manager", "Quality Inspector"] },
        "assignedLines": { "type": "array", "items": { "type": "string" } },
        "shift": { "type": "string", "enum": ["Shift 1", "Shift 2", "Shift 3"] },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "lastActive": { "type": "string" },
        "avatarColor": { "type": "string" }
      },
      "required": ["id", "name", "employeeId", "email", "role", "status"]
    },
    "ProductionEntry": {
      "title": "ProductionEntry",
      "description": "Shift production log record across SMT, MI, FA lines with outputs, hours, variance, and shortages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "shift": { "type": "string" },
        "productionLine": { "type": "string" },
        "subLine": { "type": "string" },
        "product": { "type": "string" },
        "productCode": { "type": "string" },
        "plan": { "type": "number" },
        "achieved": { "type": "number" },
        "manpowerUsed": { "type": "number" },
        "totalWorkingHrs": { "type": "number" },
        "efficiencyPercent": { "type": "number" },
        "variance": { "type": "number" },
        "unitsPerManHour": { "type": "number" },
        "rejectionQty": { "type": "number" },
        "rejectionReason": { "type": "string" },
        "shortages": { "type": "array" },
        "enteredBy": { "type": "string" },
        "enteredByName": { "type": "string" },
        "enteredAt": { "type": "string" },
        "status": { "type": "string" },
        "supervisorNotes": { "type": "string" },
        "adminApprovalStatus": { "type": "string" },
        "adminApprovalNotes": { "type": "string" },
        "adminApprovedBy": { "type": "string" },
        "adminApprovedAt": { "type": "string" }
      },
      "required": ["id", "date", "shift", "productionLine", "subLine", "product", "plan", "achieved", "enteredBy"]
    },
    "InventoryComponent": {
      "title": "InventoryComponent",
      "description": "Bill of Materials (BOM) inventory items and balance levels",
      "type": "object",
      "properties": {
        "partNumber": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "currentStock": { "type": "number" },
        "safetyStock": { "type": "number" },
        "allocatedStock": { "type": "number" },
        "unit": { "type": "string" },
        "location": { "type": "string" },
        "supplier": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["partNumber", "name", "category", "currentStock", "safetyStock", "status"]
    },
    "LiveAlert": {
      "title": "LiveAlert",
      "description": "Real-time production, shortage, and approval alert events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "line": { "type": "string" },
        "subLine": { "type": "string" },
        "severity": { "type": "string" },
        "read": { "type": "boolean" },
        "meta": { "type": "object" }
      },
      "required": ["id", "timestamp", "type", "title", "message", "severity", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "User",
      "description": "Staff profiles and access control roles"
    },
    "/production_entries/{entryId}": {
      "entity": "ProductionEntry",
      "description": "Shift production records and line metrics"
    },
    "/inventory/{partNumber}": {
      "entity": "InventoryComponent",
      "description": "BOM component balances"
    },
    "/alerts/{alertId}": {
      "entity": "LiveAlert",
      "description": "Real-time plant alerts"
    }
  }
}
